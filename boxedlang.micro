# BoxedLANG colorscheme for micro editor.
# Keeps your existing base theme and only overrides bxlang.* scopes.
# Set with: Ctrl+E -> set colorscheme boxedlang
#
# To use with a different base theme, change "monokai" below.

include "monokai"

color-link boxedlang.comment    "italic #9555b3"
color-link boxedlang.statement  "#68d087"
color-link boxedlang.type       "#84b29c"
color-link boxedlang.dollar     "#bcece1"
color-link boxedlang.number     "#7a97b2"
color-link boxedlang.special    "#c06080"
color-link boxedlang.pipe       "#885361"
color-link boxedlang.symbol     "#885361"
color-link boxedlang.identifier "#7a97b2"
